<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_common">

    <com.hjq.bar.TitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:leftIconHeight="0dp"
        app:leftIconWidth="0dp"
        app:lineVisible="false"
        app:title="@string/app_name"
        app:titleColor="@color/white" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="0dp"
        android:src="@mipmap/right_man"
        app:layout_constraintTop_toBottomOf="@+id/titleBar" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/t_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="40dp"
        android:text="Welcome User!"
        android:textColor="@color/white"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="@+id/iv1"
        app:layout_constraintTop_toTopOf="@+id/iv1" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/t_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 0.0.1 "
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/t_title"
        app:layout_constraintTop_toBottomOf="@+id/t_title" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/arrow_right_white"
        app:layout_constraintBottom_toBottomOf="@+id/t_version"
        app:layout_constraintStart_toEndOf="@+id/t_version"
        app:layout_constraintTop_toTopOf="@+id/t_version" />


    <com.angcyo.tablayout.DslTabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/bg_tab"
        android:minHeight="40dp"
        app:layout_constraintTop_toBottomOf="@+id/iv1"
        app:tab_border_radius_size="45dp"
        app:tab_deselect_color="@color/list_item_bg"
        app:tab_draw_indicator="true"
        app:tab_enable_gradient_color="true"
        app:tab_indicator_drawable="@drawable/indicator_round_background_tran"
        app:tab_indicator_height="MATCH_PARENT"
        app:tab_indicator_style="STYLE_CENTER"
        app:tab_item_is_equ_width="true"
        app:tab_select_color="@color/black"
        tools:tab_default_index="1">

        <TextView
            style="@style/TabCommonItemStyle"
            android:text="EMOJIS" />

        <TextView
            style="@style/TabCommonItemStyle"
            android:text="STICKERS" />

    </com.angcyo.tablayout.DslTabLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recy_explist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout" />
</androidx.constraintlayout.widget.ConstraintLayout>